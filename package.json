{
  "name": "slicer-web-annotation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "java -jar backend/target/deepmark-server.jar",
    "build:server": "mvn -f backend/pom.xml package",
    "test:platform": "node tests/platform-integration.mjs",
    "sample-data": "node --experimental-strip-types scripts/create-sample.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@phosphor-icons/vue": "2.2.1",
    "fflate": "^0.8.3",
    "node-forge": "1.4.2",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node-forge": "1.3.14",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  }
}
