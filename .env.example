# DeepMark configuration reference. No passwords, tokens or private keys belong here.
# Java and scripts/dev.mjs do not automatically load .env.
# Export values through your shell or process manager before starting the service.

# Direct Java launch. npm run dev uses HOST for Vite but keeps its Java API on loopback.
HOST=127.0.0.1
PORT=8787
API_PORT=8787

# Java executable used by npm run dev; Maven uses JAVA_HOME / PATH instead.
JAVA=java

# Direct launch / development defaults. This is the new role-platform database.
# Old server-data/collaboration data is separate and is NOT automatically migrated.
STATE_DIR=server-data/platform
DATASET_DIR=server-data/datasets
DIST_DIR=dist

# HTTPS requests automatically use Secure session cookies.
# Set 1 to require Secure cookies unconditionally; keep unset for localhost HTTP tests.
# COOKIE_SECURE=1

# One-use RSA password challenge lifetime: 1-300 seconds; normal default is 120.
# Short values are for isolated expiry tests, not a production requirement.
DEEPMARK_CHALLENGE_TTL_SECONDS=120

# Optional Linux deploy/*.sh overrides (see deploy/README.md).
# The deployment scripts use runtime/state and runtime/datasets by default.
# Do not export the development STATE_DIR/DATASET_DIR above for production
# unless you intentionally want to override those deployment defaults.
# DEEPMARK_ROOT=/home/deepmark/deepmark-next
# RUNTIME_DIR=/home/deepmark/runtime
# TOOLS_ENV=/home/deepmark/tools/env.sh
# JAVA_BIN=/home/deepmark/tools/jdk-21/bin/java
# BACKEND_PORT=8787
# HTTPS_PORT=8443
# STATE_DIR=/home/deepmark/runtime/state
# DATASET_DIR=/home/deepmark/runtime/datasets
# DIST_DIR=/home/deepmark/deepmark-next/dist
# TLS_CERT=/home/deepmark/runtime/tls/deepmark.crt
# TLS_KEY=/home/deepmark/runtime/tls/deepmark.key
